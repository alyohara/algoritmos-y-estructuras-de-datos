~\\ \\ \\ \\

\begin{enumerate}

\item Eliminar los par\'entesis innecesarios de las siguientes expresiones.
    \begin{itemize}
        \item[a-] \begin{verbatim} a := ( ( 9 - ( 65 /  7 ) + 60 ) * 26 ) + 40 \end{verbatim}
        \item[b-] \begin{verbatim} b := ( - 65 ) /  ( 7 + ( 60 * 26 ) + 40 ) )\end{verbatim}
    \end{itemize}


\item Desarrollar un algoritmo para, dado un conjunto de n\'umeros enteros, escribir aquellos que sean divisibles por $I$.


\item Calcular en valor de las siguientes expresiones, indicando si en TIPO del resultado obtenido se corresponde con el declarado:
    \begin{itemize}
        \item[]	\verb=VARIABLES:=
            \begin{itemize}
                \item[]	\verb=REALES a, b, c, d, e;=
                \item[] \verb=ENTERAS i, k, l, m;=
                \item[] \verb=LOGICAS $p, q, r;=
            \end{itemize}
        \item[] \verb=INICIALIZACIONES:=
            \begin{itemize}
                \item[] \begin{verbatim} n := 0;\end{verbatim}
                \item[] \begin{verbatim} b := 6.75;\end{verbatim}
                \item[] \begin{verbatim} c := 12.3;\end{verbatim}
                \item[] \begin{verbatim} l := 42;\end{verbatim}
            \end{itemize}
    \end{itemize}
\begin{tabular}{p{0.4\textwidth} p{0.4\textwidth}}
    \begin{itemize}
        \item[a-] \begin{verbatim} a := b := c;\end{verbatim}
        \item[c-] \begin{verbatim} i := l + 3 - 193;\end{verbatim}
        \item[e-] \begin{verbatim} q := 4 / 2 <> 0;\end{verbatim}
    \end{itemize}
&
    \begin{itemize}
        \item[b-] \begin{verbatim} k := 6 * 11 - l / 5;\end{verbatim}
        \item[d-] \begin{verbatim} p := ( l + 3 ) >= 10;\end{verbatim}
         \item[f-] \begin{verbatim} r := c + m * 5 - 4 * l / k;\end{verbatim}
    \end{itemize}
\\
\end{tabular}    

\item Considerando las siguientes definiciones de constantes y variables, examine cuales de las sentencias de asignaci\'on son inv\'alidas y cu\'al es el error, en caso contrario indique el resultado de la misma.
    \begin{itemize}
        \item[] \verb=CONSTANTES:=
            \begin{itemize}
                \item[] \begin{verbatim} Pagina = 255;\end{verbatim}
                \item[] \begin{verbatim} Z = `z`;\end{verbatim}
                \item[] \begin{verbatim} Gamma = 0.0045;\end{verbatim}
            \end{itemize}
        \item \verb=VARIABLES:=
            \begin{itemize}
                \item[] \verb=ENTEROS mx7, mx9;=
                \item[] \verb=REALES tar, rango;=
                \item[] \verb=CARACTERES simbolo;=
                \item[] \verb=LOGICAS respuesta;=
            \end{itemize}
    \end{itemize}

\begin{tabular}{p{0.4\textwidth} p{0.4\textwidth}}
    \begin{itemize}
        \item[a-] \begin{verbatim} mx7 := 924;\end{verbatim}
        \item[c-] \begin{verbatim} rango := Gamma;\end{verbatim}
        \item[e-] \begin{verbatim} rango := respuesta;\end{verbatim}
         \item[g-] \begin{verbatim} tar := mx9;\end{verbatim}
         \item[i-] \begin{verbatim} mx9 := Z;\end{verbatim}
    \end{itemize}
&
    \begin{itemize}
       \item[b-] \begin{verbatim} mx9 := Pagina;\end{verbatim}
       \item[d-] \begin{verbatim} Gamma := tar;\end{verbatim}
        \item[f-] \begin{verbatim} mx7 := Gamma;\end{verbatim}
         \item[h-] \begin{verbatim} simbolo := `t`;\end{verbatim}
          \item[j-] \begin{verbatim} respuesta := VERDADERO;\end{verbatim}
    \end{itemize}
\\
\end{tabular}

\item Asumiendo que x, y, z son variables enteras, ¿ qu\'e valor tendr\'an luego de la ejecuci\'on de las siguientes secuencia de instrucciones?\\
\begin{tabular}{p{0.4\textwidth} p{0.4\textwidth}}
    \begin{itemize}
        \item[a-] 
\begin{verbatim} 
x := 50;
y := 340;
z := x + y - 190;
x := 17;
y := x + z;
z := x + 200;
z := x - z - 200;
\end{verbatim}
    \end{itemize}
&
    \begin{itemize}
        \item[b-] 
\begin{verbatim}
x := 27
y := 343;
z := x + y - 300;
x := z / 10 + 23;
y := ( x + z ) / 10 * 10;
x := x + 70 + y;
y := z + x - 70;
\end{verbatim}
    \end{itemize}
\\
\end{tabular}

%5- Identificar los errores de las siguientes sentencias de asignación. Cuando encuentre una sentencia ilegal, indique el error. Si la sentencia es correcta, calcule el valor que se asignará.
%	
%	a) x1 ? b * b / -7 / 1.45;		b) x ? sqrt( abs( 5 * 5 - 4 * 4));
%	c) -v ? x * y - total;			d) precioTotal - descuento ? precioPagar;
%
%6- Escribir la declaración de las variables correspondientes, al conjunto de sentencias de asignación que se dan a continuación; y, calcular el valor si es podible.
%
%	a) a ? truncar( 3.7 );			b) b ? round( 99.9 );
%	c) c ? -round( 78.4 );		d) d ? 10 / 4;
%	e) e ? sqrt( 8 );			f) f ? round( -3.1 ) > truncar( - 3.1 );

\end{enumerate}
