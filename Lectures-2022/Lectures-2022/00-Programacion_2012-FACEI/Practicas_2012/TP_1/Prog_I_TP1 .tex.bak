\begin{document}

~\\ \\ \\ \\
Los ejercicios marcados con \maltese son de entrega obligatoria.
\begin{enumerate}

\item Escribir un algoritmos que solucionen los siguientes problemas:
    \begin{itemize}
        \item[a-] \cat Subir en ascensor al piso $X$.
 	    \item[b-] Lavarse las manos.
    \end{itemize}
\begin{small} { \textit Nota: determine a su criterio las acciones primitivas, suponiendo que quien realiza las acciones es un ``procesador inexperto''.} \end{small}

\item Describir el procesamiento (\'ambito, acciones primitivas, condiciones) as\'i como el algoritmo para resolver los siguientes problemas:
    \begin{itemize}
        \item[a-] \cat Calcular el promedio de tres n\'umeros utilizando una calculadora.
        \item[b-] Buscar la carta $x$ en un mazo de naipes (Ejemplo de supuesto: ``el mazo está completo'').
        \item[c-] De una ``tirada'' en el juego de la generala, indicar si se forma generala, tomando los dados de a uno por vez.
        \item[d-] \cat Separar un mazo de naipes (espa\~nolas) en cuatro pilas, una para cada palo.
    \end{itemize}

\item Desarrollar algoritmos que resuelvan los siguientes problemas planteados.
    \begin{itemize}
        \item[a-] Dado un n\'umero de $2n + 1$ cifras decir si el mismo es pal\'indromo (capic\'ua).
        \item[b-] \cat De una pila de tarjetas numeradas informar cual es la mayor.
        \item[c-] De una pila de tarjetas numeradas informar la cantidad de apariciones del n\'umero $N$.
    \end{itemize}

\item Escribir algoritmos que resuelvan los siguientes problemas:
    \begin{itemize}
	    \item[a-] Pasar todas las cartas de una pila de naipes $C_1$ de $N_1$ naipes (puede no estar el mazo completo) a otra $C_2$ excepto aquellos que coincidan con alg\'un palo $X$.
	    \item[b-] \cat Dada una pila de naipes de $N$ naipes, obtener la suma (cada naipe vale su n\'umero).
	    \item[c-] Encontrar e informar la posici\'on del naipe con menor n\'umero en una pila de naipes.
    \end{itemize}

\item Dise\~nar el algoritmo (diagrama de flujo y/o el pseudoc\'odigo) que muestre el mayor de tres n\'umeros enteros entrados por teclado.

\item \cat Dise\~nar el algoritmo (diagrama de flujo y/o el pseudoc\'odigo) que calcule la media de una serie de n\'umeros positivos entrados por teclado. El ingreso de un valor igual a cero indicar\'a el final del ingreso de datos.

\item Realizar el diagrama de flujo del algoritmo que calcula e imprime la suma de los n\'umeros pares comprendidos entre 2 y 100.

\item Realizar el diagrama de flujo y/o pseudoc\'odigo de un algoritmo que visualice el factorial de un n\'umero.

\item \cat Dise\~nar el algoritmo que permita dado tres n\'umeros, determinar si la suma de cualquier pareja de ellos es igual al tercer n\'umero. Si se cumple esta condición deber\'a imprimir la palabra ``iguales'' sino ``distintos''.

\item Realizar el diagrama de flujo y/o escribir el pseudoc\'odigo del algoritmo que pida al usuario el ingreso de una hora expresada en horas, minutos y segundos e indique la diferencia entre esa hora y la hora actual en horas, minutos y segundos (de a una por vez).

\end{enumerate}
\end{document}
